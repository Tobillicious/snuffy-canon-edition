+  ext i j
+  fin_cases i <;> fin_cases j <;>
+    norm_num [exchangeSwap, boundaryCharge, reservoirCharge,
+      Matrix.mul_apply, Fin.sum_univ_succ]
+
+theorem exchange_swap_total :
+    star exchangeSwap * (boundaryCharge + reservoirCharge) * exchangeSwap =
